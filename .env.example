# ============================================================
# 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填写实际值:
#   cp .env.example .env

# ---- DashScope (通义千问云 API) ----
# 获取地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---- OpenAI 兼容 API (可选) ----
# OPENAI_API_KEY=sk-your_key_here

# ---- 模型提供商 ----
# dashscope: 通义千问云 API(需 DASHSCOPE_API_KEY)
# ollama: 本地模型私有化部署(需 Ollama 服务)
# openai: OpenAI 兼容接口
MODEL_PROVIDER=dashscope

# ---- Ollama 配置(私有化部署时使用) ----
OLLAMA_BASE_URL=http://localhost:11434

# ---- 后端 API 地址 (Streamlit 连接用) ----
API_BASE_URL=http://localhost:8000
