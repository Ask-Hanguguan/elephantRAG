# Ignore everything by default
*

# Allow only specific file types
!*.py
!*.md
!*.txt
!*.ipynb
!*.jpeg
!*.svg
!*.png
!*.yml
!*.gif
!*.yaml
!*.sh

# Allow project directories
!agent/
!agent/tools/
!api/
!api/routes/
!chat/
!config/
!core/
!data/
!kb/
!model/
!prompts/
!ui/

# Allow Docker / deployment files
!Dockerfile
!docker-compose.yml
!.dockerignore
!.env.example

# Allow GitHub workflows
!.github/
!.github/workflows/

# --- Exclusions within allowed directories ---

# Python bytecode
__pycache__/
*.pyc

# Database / vector store (persisted data, regenerated on rebuild)
chroma_db/
*.db

# Log files
logs/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment secrets
.env

# Temp cleanup scripts
_cleanup*
